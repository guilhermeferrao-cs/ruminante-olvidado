---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const ultimos = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Ruminante Esquecido"
  description="Um blog pessoal minimalista sobre software, simplicidade e o que mais aparecer."
>
  <h1>Ruminante Esquecido</h1>
  <p>
    Um blog pessoal minimalista: HTML estático, CSS puro e nada de JavaScript no
    navegador.
  </p>

  <section aria-label="Posts recentes">
    <h2>Posts recentes</h2>
    <ul class="posts">
      {
        ultimos.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('pt-BR')}
            </time>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
